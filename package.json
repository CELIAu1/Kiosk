{
  "name": "kiosk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:reset": "rm -f data/kiosk.db data/kiosk.db-shm data/kiosk.db-wal && npm run db:seed",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
