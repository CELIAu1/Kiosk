# KIOSK configuration.
#
# Local development needs none of this: the app defaults to a SQLite file at
# data/kiosk.db, which `npm run db:seed` creates.

# --- Database -----------------------------------------------------------
# A libSQL/Turso URL in production, or a file: URL locally.
#   turso db create kiosk
#   turso db show kiosk --url
#   turso db tokens create kiosk
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-token"

# --- AI shop drafting (optional) ----------------------------------------
# Powers "Create for me with AI" in the shop-creation wizard. Without it the
# wizard still works and falls back to plain starter rows, and says so.
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Public URL ---------------------------------------------------------
# Only needed if the shop links KIOSK generates should use a fixed domain.
# Otherwise they are derived from the incoming request.
# KIOSK_PUBLIC_URL="https://your-app.vercel.app"
